{
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/kubernetes/.+\\.yaml$/", "/ansible/.+\\.yml$/"],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) ?(versioning=(?<versioning>.*?))? depName=(?<depName>\\S+)\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
